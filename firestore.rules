rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function getSessionData() {
      return get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data;
    }

    function isSuperStaff() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().role == 'SUPER_STAFF') || 
        (request.auth.token.email == "dangbruh010@gmail.com")
      );
    }

    function isGymStaff(gymId) {
      return isAuthenticated() && (
        isSuperStaff() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (getUserData().role == 'GYM_STAFF' || getUserData().role == 'STAFF') &&
          getUserData().gymId == gymId
        )
      );
    }

    function isMember(gymId) {
      return isAuthenticated() && (
        isSuperStaff() || 
        (exists(/databases/$(database)/documents/sessions/$(request.auth.uid)) &&
         getSessionData().gymId == gymId) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().gymId == gymId)
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId || 
        (exists(/databases/$(database)/documents/sessions/$(request.auth.uid)) &&
         getSessionData().memberId == userId) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (getUserData().id == userId || getUserData().uid == userId))
      );
    }

    function isStaff(gymId) {
      return isGymStaff(gymId);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /sessions/{sessionId} {
      allow read, write: if isAuthenticated() && request.auth.uid == sessionId;
    }

    match /gyms/{gymId} {
      allow read: if isAuthenticated();
      allow create: if isSuperStaff() || (isAuthenticated() && (
        getUserData() != null && 
        (getUserData().role == 'GYM_STAFF' || getUserData().role == 'STAFF') && 
        getUserData().gymId == gymId
      ));
      allow update: if isSuperStaff() || (isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || 
        getUserData().gymId == gymId
      ));
      allow delete: if isSuperStaff();

      match /membershipPlans/{planId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isGymStaff(gymId);
      }

      match /members/{memberId} {
        allow read: if isGymStaff(gymId) || isOwner(memberId);
        allow create, update, delete: if isGymStaff(gymId);
      }
    }

    // Collection Group rule for phone-based login
    match /{path=**}/members/{memberId} {
      allow list: if isAuthenticated();
    }

    match /users/{userId} {
      // Allow individual profile fetching for login verification
      allow get: if isAuthenticated();
      // Allow listing for super staff or staff of the gym
      allow list: if isAuthenticated() && (isSuperStaff() || isGymStaff(resource.data.gymId) || isMember(resource.data.gymId) || isOwner(userId));
      
      // Only Super Staff or Gym Staff can create/update users in their gym
      allow create: if isAuthenticated() && (
        isOwner(userId) || 
        isSuperStaff() || 
        isGymStaff(request.resource.data.gymId) ||
        (userId == 'heisenberg' && !exists(/databases/$(database)/documents/users/heisenberg))
      );
      allow update: if isAuthenticated() && (isOwner(userId) || isGymStaff(resource.data.gymId) || isSuperStaff());
      allow delete: if isSuperStaff();
    }

    match /workouts/{workoutId} {
      // Members can read workouts from their gym or system-wide, or if they created it
      allow read: if isAuthenticated() && (
        isMember(resource.data.gymId) || 
        resource.data.gymId == 'system' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && resource.data.createdBy == getUserData().id)
      );
      allow create, update: if isAuthenticated() && (isSuperStaff() || isGymStaff(request.resource.data.gymId));
      allow delete: if isAuthenticated() && (isSuperStaff() || isGymStaff(resource.data.gymId));
    }

    match /checkins/{checkinId} {
      allow read: if isAuthenticated() && (isStaff(resource.data.gymId) || isOwner(resource.data.memberId));
      allow create: if isAuthenticated() && (isOwner(request.resource.data.memberId) || isStaff(request.resource.data.gymId));
      allow update, delete: if isStaff(resource.data.gymId);
    }

    match /workoutLogs/{logId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.memberId) || isStaff(resource.data.gymId));
      allow create: if isAuthenticated() && isOwner(request.resource.data.memberId);
      allow update, delete: if isOwner(resource.data.memberId) || isStaff(resource.data.gymId);
    }

    match /progress/{entryId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.memberId) || isStaff(resource.data.gymId));
      allow create: if isAuthenticated() && isOwner(request.resource.data.memberId);
      allow update, delete: if isOwner(resource.data.memberId);
    }

    match /broadcasts/{broadcastId} {
      allow read: if isAuthenticated() && isMember(resource.data.gymId);
      allow create, update: if isStaff(request.resource.data.gymId);
      allow delete: if isStaff(resource.data.gymId);
    }

    match /workoutProgress/{progressId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.memberId) || isStaff(resource.data.gymId) || isSuperStaff());
      allow create: if isAuthenticated() && isOwner(request.resource.data.memberId) && (request.resource.data.gymId == getSessionData().gymId || request.resource.data.gymId == getUserData().gymId);
      allow update: if isAuthenticated() && isOwner(resource.data.memberId) && (request.resource.data.gymId == resource.data.gymId);
      allow delete: if isSuperStaff();
    }
  }
}
