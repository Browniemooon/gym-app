{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_STAFF", "GYM_STAFF", "STAFF", "MEMBER"] },
        "gymId": { "type": "string" },
        "status": { "type": "string" },
        "membershipExpiresAt": { "type": "number" },
        "membershipPlanId": { "type": "string" },
        "assignedWorkoutId": { "type": "string" },
        "autoApproveCheckin": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "gymConfig": { "type": "object" }
      },
      "required": ["uid", "name", "role", "gymId", "createdAt"]
    },
    "Gym": {
      "title": "Gym",
      "description": "Gym configuration and business details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "paymentConfig": { "type": "object" },
        "autoApproveDefault": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name", "ownerId", "createdAt"]
    },
    "MembershipPlan": {
      "title": "MembershipPlan",
      "description": "Available subscription plans for a gym",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gymId": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "durationDays": { "type": "number" }
      },
      "required": ["id", "gymId", "name", "price", "durationDays"]
    },
    "Workout": {
      "title": "Workout",
      "description": "Workout plan definition",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gymId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "splitType": { "type": "string" },
        "dailyWorkouts": { "type": "array" },
        "isDefault": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "gymId", "title", "createdBy", "createdAt"]
    },
    "CheckIn": {
      "title": "CheckIn",
      "description": "Member check-in record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "memberId": { "type": "string" },
        "gymId": { "type": "string" },
        "memberName": { "type": "string" },
        "timestamp": { "type": "number" },
        "day": { "type": "string" },
        "time": { "type": "string" },
        "status": { "type": "string", "enum": ["request", "approved", "rejected"] },
        "approvedAt": { "type": "number" },
        "approvedBy": { "type": "string" },
        "staffName": { "type": "string" }
      },
      "required": ["id", "memberId", "gymId", "memberName", "timestamp", "status"]
    },
    "Broadcast": {
      "title": "Broadcast",
      "description": "Broadcast message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "number" },
        "senderId": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "gymId": { "type": "string" }
      },
      "required": ["id", "message", "timestamp", "senderId", "targetType"]
    },
    "ProgressEntry": {
      "title": "ProgressEntry",
      "description": "Member progress tracking entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "memberId": { "type": "string" },
        "gymId": { "type": "string" },
        "weight": { "type": "number" },
        "bodyFat": { "type": "number" },
        "chest": { "type": "number" },
        "waist": { "type": "number" },
        "arms": { "type": "number" },
        "thighs": { "type": "number" },
        "timestamp": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["id", "memberId", "gymId", "weight", "timestamp"]
    }
  },
  "firestore": {
    "/gyms/{gymId}": {
      "schema": "Gym",
      "description": "Gym settings and payment config"
    },
    "/gyms/{gymId}/membershipPlans/{planId}": {
      "schema": "MembershipPlan",
      "description": "Membership tiers for a gym"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles"
    },
    "/workouts/{workoutId}": {
      "schema": "Workout",
      "description": "Workout plans"
    },
    "/checkins/{checkinId}": {
      "schema": "CheckIn",
      "description": "Check-in records"
    },
    "/broadcasts/{broadcastId}": {
      "schema": "Broadcast",
      "description": "Broadcast messages"
    },
    "/progress/{entryId}": {
      "schema": "ProgressEntry",
      "description": "Progress tracking entries"
    }
  }
}
